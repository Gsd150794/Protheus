User Function AOMS021()

	Local aArea		:= FWGetArea()
	Local lRet		:= .T.

	DBSelectArea("SB1")
	DBSetOrder(1)
	DBSeek(xFilial("SB1")+GdFieldGet("C6_PRODUTO",n))

	If (SB1->B1_TIPO == 'PA')
	
		lRet := .F.

	EndIf
	
	FWRestArea(aArea)
	
Return (lRet)
