EndIf
TRFunction():New(oBaixas:Cell("E5_VALORPG")		,/*[cID*/, "SUM", oBreak1  , STR0071, tm(E5_VALOR,oBaixas:Cell("E5_VALORPG"):nSize,nDecs)	, {|| aRelat[nI][27]}	, .F., .F.,.F.) //"Sub Total"

