	EndIf	
	
//             New(<oParent>					, [cID]	, <cFunction>, [oBreak], [cTitle], [cPicture], [uFormula], [lEndSection], [lEndReport]) --> NIL
TRFunction():New(oBaixas:Cell("E5_VALOR")		,/*cID*/, "SUM", oBreak1  , STR0071, tm(E5_VALOR,oBaixas:Cell("E5_VALOR"):nSize,nDecs)		, {|| aRelat[nI,11]}	, .F., .F.,.F.) //"Sub Total"
