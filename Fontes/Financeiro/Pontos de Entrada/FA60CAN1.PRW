#Include "TOTVS.ch"

/*
===============================================================================================================================
Programa----------: FA60CAN1
Autor-------------: Heder Jose Andrade
Data da Criacao---: 27/07/2010
Descrição---------: Ponto de Entrada no cancelamento do bordero.
Parametros--------: Nenhum
Retorno-----------: Nenhum
===============================================================================================================================
*/
User Function FA60CAN1
          	
RecLock("SE1",.F.)
IIf(Len(AllTrim(SE1->E1_NUMBCO))>0, SE1->E1_I_NBCO := AllTrim(SE1->E1_NUMBCO), "")	     	
MSUnLock()

Return .T.
