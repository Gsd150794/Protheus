User Function FI040TPCP()

Local _aCampos := aClone( ParamIXB[01] )

aAdd( _aCampos , { "E5_VLJUROS" , "N" , 17 , 2 } )
aAdd( _aCampos , { "E5_VLMULTA" , "N" , 17 , 2 } )
aAdd( _aCampos , { "E5_VLCORRE" , "N" , 17 , 2 } )
aAdd( _aCampos , { "E5_VLDESCO" , "N" , 17 , 2 } )

Return( _aCampos )
