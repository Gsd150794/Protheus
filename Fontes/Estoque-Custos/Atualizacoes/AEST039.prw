#Include "TOTVS.ch"

/*
===============================================================================================================================
Programa----------: AEST039
Autor-------------: Lucas Crevilari
Data da Criacao---: 02/09/2014
Descrição---------: Verifica conteudo do C2_LOCAL para deixá-lo habilitado ou não (X3_WHEN)
Parametros--------:
Retorno-----------:
===============================================================================================================================
*/               
User Function AEST039( cLocal )
      
Local aArea		:= FWGetArea()
Local lOk 		:= .T.  

Default cLocal := ''

If INCLUI .And. M->C2_LOCAL == "36"
	lOk := .F.
ElseIf INCLUI .And. M->C2_LOCAL <> "30"
	lOk := .T.
Else
	lOk := .F.
EndIf

FWRestArea(aArea)
Return(lOk) 
