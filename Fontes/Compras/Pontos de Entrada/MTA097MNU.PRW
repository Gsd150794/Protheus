#Include "TOTVS.ch"

/*
============================================================================================================================================
Programa----------: MTA097MNU
Autor-------------: Josué Danich Prestes
Data da Criacao---: 23/03/2017
Descrição---------: Ponto de Entrada na função MenuDef() no programa MATA097.PRW - Chamado 19345
Parametros--------: Nenhum
Retorno-----------: Nenhum
============================================================================================================================================
*/
User Function MTA097MNU

Local _nPos:=aScan(aRotina, {|R| Upper(R[1]) == Upper("Estornar") } )
Local _atemp := aRotina
Local _nI := 1

If _nPos # 0
  aRotina := {}
  While _nI <= Len(_atemp)
    If _nI != _nPos
      aAdd(aRotina,_atemp[_nI])
    EndIf
    _nI++
  EndDo
EndIf

Return

